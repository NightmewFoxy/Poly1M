//@version=6
// TMA divergence debug — visual audit of the Poly1M backtest detector.
// Replicates backtests/cand_regdiv.py gen_divs() + the owner's touch-21SMMA
// entry (touch21.py) EXACTLY:
//   - fractal pivots: highest/lowest of 3 bars each side, confirmed 3 bars late
//   - divergence: new confirmed pivot vs the OLDEST stored pivot (of the last
//     8) within 60 bars — one comparison only, matching the backtest's loop
//   - hidden bearish: price lower high + RSI higher high (orange)
//   - regular bearish: price higher high + RSI lower high (red)
//   - hidden bullish: price higher low + RSI lower low (teal)
//   - regular bullish: price lower low + RSI higher low (green)
//   - entry (hidden only, the B-strategy): after signal confirm, first bar
//     that TOUCHES the previous bar's SMMA21 within 40 bars (or next bar's
//     open if price is already beyond the MA); SL at divergence extreme,
//     TP = entry +/- 2R. Labels + SL/TP stubs drawn on the price chart.
// Add to a BTCUSDT/ETHUSDT 15m chart. Known minor difference vs backtest:
// Pine's pivothigh/low uses strict comparison, the Python uses max/min
// (ties count) — exact-tie pivots are vanishingly rare on crypto prices.

indicator("TMA Divergence Debug", overlay=false, max_lines_count=500, max_labels_count=500)

showHidden  = input.bool(true,  "Show hidden divergences (B-strategy)")
showRegular = input.bool(true,  "Show regular divergences")
showTrades  = input.bool(true,  "Show touch-21SMMA entries (hidden only)")
maxGap      = input.int(60,  "Max bars between pivots")
entryWin    = input.int(40,  "Entry window after confirm (bars)")
tpR         = input.float(2.0, "TP (R multiple)")

rsiV = ta.rsi(close, 14)
ma21 = ta.rma(close, 21)

plot(rsiV, "RSI 14", color=color.yellow)
hline(70, color=color.gray)
hline(50, color=color.new(color.gray, 50))
hline(30, color=color.gray)
plot(ma21, "SMMA 21", color=color.orange, force_overlay=true)

ph = ta.pivothigh(high, 3, 3)
pl = ta.pivotlow(low, 3, 3)

// stored pivots: bar index, price, rsi (last 8, matching last_ph[-8:])
var phBar = array.new<int>()
var phPx  = array.new<float>()
var phRsi = array.new<float>()
var plBar = array.new<int>()
var plPx  = array.new<float>()
var plRsi = array.new<float>()

// pending hidden-divergence entries: dir(+1/-1), extreme(SL), confirm bar, immediate flag
var pdDir = array.new<int>()
var pdExt = array.new<float>()
var pdBar = array.new<int>()
var pdImm = array.new<int>()

drawDiv(int b1, float p1, float r1, int b2, float p2, float r2, color col) =>
    line.new(b1, p1, b2, p2, xloc=xloc.bar_index, color=col, width=2, force_overlay=true)
    line.new(b1, r1, b2, r2, xloc=xloc.bar_index, color=col, width=2)

if not na(ph)
    j = bar_index - 3
    // compare against the OLDEST stored pivot high within maxGap (backtest semantics)
    if array.size(phBar) > 0
        done = false
        for k = 0 to array.size(phBar) - 1
            if not done and j - array.get(phBar, k) <= maxGap
                pB = array.get(phBar, k)
                pP = array.get(phPx, k)
                pR = array.get(phRsi, k)
                nR = rsiV[3]
                if ph > pP and nR < pR and showRegular          // regular bearish
                    drawDiv(pB, pP, pR, j, ph, nR, color.red)
                if ph < pP and nR > pR                          // hidden bearish
                    if showHidden
                        drawDiv(pB, pP, pR, j, ph, nR, color.orange)
                    if showTrades
                        array.push(pdDir, -1)
                        array.push(pdExt, math.max(ph, pP))
                        array.push(pdBar, bar_index)
                        array.push(pdImm, close < ma21 ? 1 : 0)
                done := true
    array.push(phBar, j)
    array.push(phPx, ph)
    array.push(phRsi, rsiV[3])
    if array.size(phBar) > 8
        array.shift(phBar)
        array.shift(phPx)
        array.shift(phRsi)

if not na(pl)
    j = bar_index - 3
    if array.size(plBar) > 0
        done = false
        for k = 0 to array.size(plBar) - 1
            if not done and j - array.get(plBar, k) <= maxGap
                pB = array.get(plBar, k)
                pP = array.get(plPx, k)
                pR = array.get(plRsi, k)
                nR = rsiV[3]
                if pl < pP and nR > pR and showRegular          // regular bullish
                    drawDiv(pB, pP, pR, j, pl, nR, color.green)
                if pl > pP and nR < pR                          // hidden bullish
                    if showHidden
                        drawDiv(pB, pP, pR, j, pl, nR, color.teal)
                    if showTrades
                        array.push(pdDir, 1)
                        array.push(pdExt, math.min(pl, pP))
                        array.push(pdBar, bar_index)
                        array.push(pdImm, close > ma21 ? 1 : 0)
                done := true
    array.push(plBar, j)
    array.push(plPx, pl)
    array.push(plRsi, rsiV[3])
    if array.size(plBar) > 8
        array.shift(plBar)
        array.shift(plPx)
        array.shift(plRsi)

// process pending entries (touch of PREVIOUS bar's SMMA21, matching ma21[jj-1])
if array.size(pdDir) > 0
    k = 0
    while k < array.size(pdDir)
        dir = array.get(pdDir, k)
        ext = array.get(pdExt, k)
        cb  = array.get(pdBar, k)
        imm = array.get(pdImm, k)
        entry = float(na)
        if bar_index > cb and imm == 1
            entry := open                                        // already beyond MA: next-bar open
        else if bar_index > cb and bar_index - cb <= entryWin
            lvl = ma21[1]
            if dir < 0 and high >= lvl and low <= lvl
                entry := open > lvl ? open : lvl
            if dir > 0 and low <= lvl and high >= lvl
                entry := open < lvl ? open : lvl
        expired = bar_index - cb > entryWin
        if not na(entry)
            risk = math.abs(entry - ext)
            if risk / entry >= 0.0008 and ((dir > 0) == (entry > ext))
                tp = entry + dir * tpR * risk
                label.new(bar_index, entry, (dir < 0 ? "SHORT " : "LONG ") + str.tostring(entry, format.mintick), style=dir < 0 ? label.style_label_down : label.style_label_up, color=dir < 0 ? color.maroon : color.navy, textcolor=color.white, size=size.small, force_overlay=true)
                line.new(bar_index, ext, bar_index + 20, ext, color=color.red, style=line.style_dashed, force_overlay=true)
                line.new(bar_index, tp,  bar_index + 20, tp,  color=color.lime, style=line.style_dashed, force_overlay=true)
        if not na(entry) or expired
            array.remove(pdDir, k)
            array.remove(pdExt, k)
            array.remove(pdBar, k)
            array.remove(pdImm, k)
        else
            k += 1
